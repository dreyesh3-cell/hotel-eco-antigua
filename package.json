{
  "name": "hotel-eco-antigua",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "pnpm run dev:frontend",
    "dev:frontend": "vite --config frontend/vite.config.mjs",
    "dev:backend": "pnpm run build:backend && wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 8787 --inspector-port 0",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "vite build --config frontend/vite.config.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config dist/server/wrangler.json --persist-to .wrangler/state",
    "test": "node --test backend/*.test.js frontend/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test backend/domain.test.js frontend/booking-form.test.js",
    "test:api": "newman run api/Hotel-Eco-Antigua.postman_collection.json --environment api/local.postman_environment.json",
    "typecheck": "tsc --noEmit --project tsconfig.frontend.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "c8": "^10.1.3",
    "drizzle-kit": "0.31.10",
    "newman": "^6.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
